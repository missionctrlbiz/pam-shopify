generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

// ==========================================
// NEXTAUTH.JS MODELS
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password for credentials login
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leads         Lead[]
  soapHistories SoapHistory[]
  usageEvents   UsageEvent[]

  // Content Engine relations (additive — do not remove existing relations above)
  approvedEntries ProductionCalendarEntry[]
  contentIdeas    ContentIdea[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// BUYER WHITELIST (from Shopify webhooks)
// ==========================================
model Buyer {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ==========================================
// LEADS (migrated from JSON file storage)
// ==========================================
model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  source    String   @default("lead-magnet")
  ip        String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
}

// ==========================================
// SOAP NOTE HISTORY
// ==========================================
model SoapHistory {
  id        String   @id @default(cuid())
  userId    String
  input     String
  output    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// USAGE ANALYTICS
// ==========================================
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "soap_generate", "cheat_sheet_view", "lead_signup", etc.
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

// ==========================================
// CONTENT ENGINE — ENUMS
// ==========================================

enum Platform {
  IG
  FB
  TIKTOK
  LINKEDIN
  EMAIL
  VIDEO
}

enum FunnelStage {
  AWARENESS
  CONSIDERATION
  CONVERSION
  RETENTION
}

enum PostType {
  CAROUSEL
  VIDEO
  TEXT_POST
  REEL
  STORY
  EMAIL_LESSON
}

enum PublishStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  GENERATING
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  CAROUSEL_PNG
  VIDEO_MP4
  TEXT_POST
  EMAIL_HTML
  AUDIO_MP3
  VIDEO_SCRIPT_JSON
}

enum AssetStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

enum RenderJobType {
  CAROUSEL
  VIDEO
  AUDIO
  REPURPOSE
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum QualityGateStatus {
  PENDING
  PASSED
  FAILED
  BYPASSED
}

enum FieldCategory {
  CHIEF_COMPLAINT
  MSE
  DIAGNOSTIC
  RISK_ASSESSMENT
  DOCUMENTATION
  INTERVIEW
}

// ==========================================
// CONTENT ENGINE — MODEL 1: ClinicalField
// ==========================================

model ClinicalField {
  id              String        @id @default(cuid())
  fieldKey        String        @unique
  fieldCategory   FieldCategory
  displayName     String
  description     String        @default("")
  exampleValues   Json          @default("[]")
  clinicalContext String?
  isActive        Boolean       @default(true)
  fieldType       String        @default("text")
  createdAt       DateTime      @default(now())

  contentIdeas ContentIdea[]

  @@index([isActive])
  @@index([fieldCategory])
}

// ==========================================
// CONTENT ENGINE — MODEL 2: ProductionCalendarEntry
// ==========================================

model ProductionCalendarEntry {
  id            String        @id @default(cuid())
  dayNumber     Int
  entryDate     DateTime
  platform      Platform
  topic         String
  contentGoal   String
  funnelStage   FunnelStage
  postType      PostType
  hook          String
  cta           String
  publishStatus PublishStatus  @default(DRAFT)
  approvedAt    DateTime?
  approvedById  String?
  scheduledAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  approvedBy  User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  contentIdea ContentIdea?

  @@index([entryDate])
  @@index([publishStatus])
  @@index([platform])
  @@index([approvedById])
}

// ==========================================
// CONTENT ENGINE — MODEL 3: ContentIdea
// ==========================================

model ContentIdea {
  id                String            @id @default(cuid())
  calendarEntryId   String            @unique
  clinicalFieldId   String?
  masterJson        Json
  rawGeminiPrompt   String
  qualityGateStatus QualityGateStatus @default(PENDING)
  generatedById     String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  calendarEntry     ProductionCalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  clinicalField     ClinicalField?          @relation(fields: [clinicalFieldId], references: [id], onDelete: SetNull)
  generatedBy       User                    @relation(fields: [generatedById], references: [id])

  assets            ContentAsset[]
  qualityGateResult QualityGateResult?
  videoScript       VideoScript?
  renderJobs        RenderJob[]

  @@index([clinicalFieldId])
  @@index([generatedById])
}

// ==========================================
// CONTENT ENGINE — MODEL 4: QualityGateResult
// ==========================================

model QualityGateResult {
  id                String      @id @default(cuid())
  contentIdeaId     String      @unique
  question1         String
  question2         String
  question3         String
  question4         String
  question5         String
  score1            Int
  score2            Int
  score3            Int
  score4            Int
  score5            Int
  overallScore      Decimal
  passed            Boolean
  geminiRawResponse Json
  evaluatedAt       DateTime    @default(now())

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
}

// ==========================================
// CONTENT ENGINE — MODEL 5: VideoScript
// ==========================================

model VideoScript {
  id                String      @id @default(cuid())
  contentIdeaId     String      @unique
  scriptJson        Json
  totalDurationSecs Int
  elevenLabsJobId   String?
  audioStorageUrl   String?
  audioStatus       AssetStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
}

// ==========================================
// CONTENT ENGINE — MODEL 6: ContentAsset
// ==========================================

model ContentAsset {
  id            String      @id @default(cuid())
  contentIdeaId String
  renderJobId   String?
  platform      Platform
  assetType     AssetType
  fileName      String
  storageUrl    String?
  storagePath   String?
  version       Int         @default(1)
  status        AssetStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  renderJob   RenderJob?  @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  @@index([contentIdeaId, platform])
  @@index([status])
}

// ==========================================
// CONTENT ENGINE — MODEL 7: RenderJob
// ==========================================

model RenderJob {
  id                  String          @id @default(cuid())
  contentIdeaId       String
  jobType             RenderJobType
  cloudRunExecutionId String?
  cloudTasksTaskId    String?
  status              RenderJobStatus @default(QUEUED)
  inputPayload        Json
  queuedAt            DateTime        @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  retryCount          Int             @default(0)

  contentIdea ContentIdea    @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  assets      ContentAsset[]
}
