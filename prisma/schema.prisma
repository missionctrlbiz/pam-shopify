generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

// ==========================================
// NEXTAUTH.JS MODELS
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // Hashed password for credentials login
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  leads         Lead[]
  soapHistories SoapHistory[]
  usageEvents   UsageEvent[]

  // Content Engine relations (additive — do not remove existing relations above)
  approvedEntries ProductionCalendarEntry[]
  contentIdeas    ContentIdea[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String @map("user_id")
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// BUYER WHITELIST (from Shopify webhooks)
// ==========================================
model Buyer {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  @@map("buyers")
}

// ==========================================
// LEADS (migrated from JSON file storage)
// ==========================================
model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  source    String   @default("lead-magnet")
  ip        String?
  userId    String? @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@map("leads")
}

// ==========================================
// SOAP NOTE HISTORY
// ==========================================
model SoapHistory {
  id        String   @id @default(cuid())
  userId    String @map("user_id")
  input     String
  output    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("soap_histories")
}

// ==========================================
// USAGE ANALYTICS
// ==========================================
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String? @map("user_id")
  action    String   // "soap_generate", "cheat_sheet_view", "lead_signup", etc.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("usage_events")
}

// ==========================================
// CONTENT ENGINE — ENUMS
// ==========================================

enum Platform {
  IG
  FB
  TIKTOK
  LINKEDIN
  EMAIL
  VIDEO
}

enum FunnelStage {
  AWARENESS
  CONSIDERATION
  CONVERSION
  RETENTION
}

enum PostType {
  CAROUSEL
  VIDEO
  TEXT_POST
  REEL
  STORY
  EMAIL_LESSON
}

enum PublishStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  GENERATING
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  CAROUSEL_PNG
  VIDEO_MP4
  TEXT_POST
  EMAIL_HTML
  AUDIO_MP3
  VIDEO_SCRIPT_JSON
}

enum AssetStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

enum RenderJobType {
  CAROUSEL
  VIDEO
  AUDIO
  REPURPOSE
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum QualityGateStatus {
  PENDING
  PASSED
  FAILED
  BYPASSED
}

enum FieldCategory {
  CHIEF_COMPLAINT
  MSE
  DIAGNOSTIC
  RISK_ASSESSMENT
  DOCUMENTATION
  INTERVIEW
}

// ==========================================
// CONTENT ENGINE — MODEL 1: ClinicalField
// ==========================================

model ClinicalField {
  id              String        @id @default(cuid())
  fieldKey        String        @unique @map("field_key")
  fieldCategory   FieldCategory @map("field_category")
  displayName     String @map("display_name")
  description     String        @default("")
  exampleValues   Json          @default("[]") @map("example_values")
  clinicalContext String? @map("clinical_context")
  isActive        Boolean       @default(true) @map("is_active")
  fieldType       String        @default("text") @map("field_type")
  createdAt       DateTime      @default(now()) @map("created_at")

  contentIdeas ContentIdea[]

  @@index([isActive])
  @@index([fieldCategory])
  @@map("clinical_fields")
}

// ==========================================
// CONTENT ENGINE — MODEL 2: ProductionCalendarEntry
// ==========================================

model ProductionCalendarEntry {
  id            String        @id @default(cuid())
  dayNumber     Int @map("day_number")
  entryDate     DateTime @map("entry_date")
  platform      Platform
  topic         String
  contentGoal   String @map("content_goal")
  funnelStage   FunnelStage @map("funnel_stage")
  postType      PostType @map("post_type")
  hook          String
  cta           String
  publishStatus PublishStatus  @default(DRAFT) @map("publish_status")
  approvedAt    DateTime? @map("approved_at")
  approvedById  String? @map("approved_by_id")
  scheduledAt   DateTime? @map("scheduled_at")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  approvedBy  User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  contentIdea ContentIdea?

  @@index([entryDate])
  @@index([publishStatus])
  @@index([platform])
  @@index([approvedById])
  @@map("production_calendar_entries")
}

// ==========================================
// CONTENT ENGINE — MODEL 3: ContentIdea
// ==========================================

model ContentIdea {
  id                String            @id @default(cuid())
  calendarEntryId   String            @unique @map("calendar_entry_id")
  clinicalFieldId   String? @map("clinical_field_id")
  masterJson        Json @map("master_json")
  rawGeminiPrompt   String @map("raw_gemini_prompt")
  qualityGateStatus QualityGateStatus @default(PENDING) @map("quality_gate_status")
  generatedById     String @map("generated_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  calendarEntry     ProductionCalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  clinicalField     ClinicalField?          @relation(fields: [clinicalFieldId], references: [id], onDelete: SetNull)
  generatedBy       User                    @relation(fields: [generatedById], references: [id])

  assets            ContentAsset[]
  qualityGateResult QualityGateResult?
  videoScript       VideoScript?
  renderJobs        RenderJob[]

  @@index([clinicalFieldId])
  @@index([generatedById])
  @@map("content_ideas")
}

// ==========================================
// CONTENT ENGINE — MODEL 4: QualityGateResult
// ==========================================

model QualityGateResult {
  id                String      @id @default(cuid())
  contentIdeaId     String      @unique @map("content_idea_id")
  question1         String
  question2         String
  question3         String
  question4         String
  question5         String
  score1            Int
  score2            Int
  score3            Int
  score4            Int
  score5            Int
  overallScore      Decimal @map("overall_score")
  passed            Boolean
  geminiRawResponse Json @map("gemini_raw_response")
  evaluatedAt       DateTime    @default(now()) @map("evaluated_at")

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  @@map("quality_gate_results")
}

// ==========================================
// CONTENT ENGINE — MODEL 5: VideoScript
// ==========================================

model VideoScript {
  id                String      @id @default(cuid())
  contentIdeaId     String      @unique @map("content_idea_id")
  scriptJson        Json @map("script_json")
  totalDurationSecs Int @map("total_duration_secs")
  elevenLabsJobId   String? @map("eleven_labs_job_id")
  audioStorageUrl   String? @map("audio_storage_url")
  audioStatus       AssetStatus @default(PENDING) @map("audio_status")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  @@map("video_scripts")
}

// ==========================================
// CONTENT ENGINE — MODEL 6: ContentAsset
// ==========================================

model ContentAsset {
  id            String      @id @default(cuid())
  contentIdeaId String @map("content_idea_id")
  renderJobId   String? @map("render_job_id")
  platform      Platform
  assetType     AssetType @map("asset_type")
  fileName      String @map("file_name")
  storageUrl    String? @map("storage_url")
  storagePath   String? @map("storage_path")
  version       Int         @default(1)
  status        AssetStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  renderJob   RenderJob?  @relation(fields: [renderJobId], references: [id], onDelete: SetNull)

  @@index([contentIdeaId, platform])
  @@index([status])
  @@map("content_assets")
}

// ==========================================
// CONTENT ENGINE — MODEL 7: RenderJob
// ==========================================

model RenderJob {
  id                  String          @id @default(cuid())
  contentIdeaId       String @map("content_idea_id")
  jobType             RenderJobType @map("job_type")
  cloudRunExecutionId String? @map("cloud_run_execution_id")
  cloudTasksTaskId    String? @map("cloud_tasks_task_id")
  status              RenderJobStatus @default(QUEUED)
  inputPayload        Json @map("input_payload")
  queuedAt            DateTime        @default(now()) @map("queued_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  errorMessage        String? @map("error_message")
  retryCount          Int             @default(0) @map("retry_count")

  contentIdea ContentIdea    @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  assets      ContentAsset[]
  @@map("render_jobs")
}
